# Install as /etc/academiccloud/academiccloud.env with root:root ownership and mode 0600.
# Replace every placeholder. Never commit the installed file.
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
APP_ORIGIN=https://cloud.example.edu
DATABASE_PATH=/var/lib/academiccloud/academiccloud.sqlite
MIGRATIONS_DIRECTORY=/opt/academiccloud/current/database/migrations
RULESET_ADMISSIONS_DIRECTORY=/opt/academiccloud/current/database/ruleset-admissions

STORAGE_PROVIDER=aliyun-oss
OSS_ENDPOINT=https://oss-ap-southeast-3.aliyuncs.com
OSS_REGION=oss-ap-southeast-3
OSS_BUCKET=replace-private-bucket
OSS_ACCESS_KEY_ID=replace-through-secret-installation
OSS_ACCESS_KEY_SECRET=replace-through-secret-installation
# Optional dedicated OSS custom browser domain (cname) for signed download/
# preview GET URLs, e.g. https://files.ajtlab.top. When absent, downloads
# keep working on the native bucket domain and inline Preview fails safely
# with preview_unavailable. Install the exact HTTPS origin only; the custom
# domain must map to the same private bucket and never expose public access.
# OSS_BROWSER_ENDPOINT=https://files.ajtlab.top
# Static STS tokens expire and are not a long-term credential rotation mechanism.
# OSS_STS_TOKEN=
OSS_UPLOAD_AUTHORIZATION_SECONDS=300
OSS_DOWNLOAD_AUTHORIZATION_SECONDS=300
OSS_REQUEST_TIMEOUT_MILLISECONDS=30000

# Derived Compute is disabled until the separately gated cutover installs a
# dedicated Local Pull machine secret in Core and the outbound-only worker.
# Normal production uses local_pull. github_actions remains a separately
# authorized emergency/CI adapter and must not be selected implicitly.
COMPUTE_PROVIDER=disabled
COMPUTE_CORE_BASE_URL=https://cloud.example.edu
# COMPUTE_WORKER_BOOTSTRAP_SECRET=replace-through-secret-installation
# Emergency/CI adapter only; never enable for normal production processing:
# GITHUB_COMPUTE_DISPATCH_TOKEN=replace-through-secret-installation
# GITHUB_COMPUTE_REPOSITORY=owner/academiccloud
# GITHUB_COMPUTE_WORKFLOW=derived-compute-worker.yml
# GITHUB_COMPUTE_REF=codex/approved-compute-release
