# Install outside Git as:
# /srv/academiccloud-compute/control/academiccloud-local-compute.env
# Owner academiccloud:academiccloud, mode 0600. Replace every placeholder.
NODE_ENV=production
# The coordinated candidate systemd units require this shared guard. Provision
# its private writable directory/config as described in ADR-049 before cutover.
ACADEMICCLOUD_NATIVE_RESOURCE_GUARD_CONFIG=/srv/academiccloud-compute/control/native-resource-guard.json
ACADEMICCLOUD_COMPUTE_CORE_BASE_URL=https://cloud.example.edu
ACADEMICCLOUD_COMPUTE_WORKER_ID=owner-laptop.wsl2
ACADEMICCLOUD_COMPUTE_BOOTSTRAP_SECRET=replace-through-secret-installation

# NORMAL and BURST both keep whole-job concurrency at one. PAUSED makes no new
# claims. The service Nice value supplies NORMAL's restrained host priority.
ACADEMICCLOUD_COMPUTE_MODE=NORMAL
# Unguarded default 20000. Shared-guard execution uses immediate pulls and an
# empty/busy poll waits two seconds after releasing the native resource.
# Lower unguarded waits only when a measured outbound edge idle timeout is
# shorter than Core's bounded long-poll window; 1000-25000 milliseconds.
ACADEMICCLOUD_COMPUTE_PULL_WAIT_MILLISECONDS=20000
# Keep qualified Paddle/NuExtract processes warm only while work is arriving. The
# worker unloads both after this bounded idle interval and never retains source
# or derived document content for warming. Shared-guard execution closes both
# before releasing each native lease rather than retaining idle processes.
ACADEMICCLOUD_COMPUTE_IDLE_TTL_MILLISECONDS=300000

# Selected only after the exact CPU/GPU qualification for this release passes.
PADDLE_OCR_DEVICE=gpu
BIBLIOGRAPHY_LLAMA_GPU_LAYERS=999
