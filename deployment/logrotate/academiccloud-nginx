/var/log/academiccloud/nginx-access.log /var/log/academiccloud/nginx-error.log {
    daily
    rotate 14
    maxsize 10M
    missingok
    notifempty
    compress
    delaycompress
    create 0640 www-data adm
    sharedscripts
    postrotate
        invoke-rc.d nginx rotate >/dev/null 2>&1 || true
    endscript
}
