{
  "name": "@academiccloud/compute",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build --workspace @academiccloud/compute-contracts && tsx --test test/**/*.test.ts",
    "build": "tsc -p tsconfig.build.json",
    "worker": "npm run build --workspace @academiccloud/compute-contracts && tsx src/main.ts",
    "worker:prod": "node dist/main.js",
    "worker:local:prod": "node dist/local-pull-main.js",
    "memory:probe": "node --expose-gc --import tsx scripts/memory-probe.ts"
  },
  "dependencies": {
    "@academiccloud/compute-contracts": "0.1.0",
    "@napi-rs/canvas": "1.0.7",
    "pdfjs-dist": "6.2.108"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.23.12"
  }
}
