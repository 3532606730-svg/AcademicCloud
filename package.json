{
  "name": "academiccloud",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names api,web --prefix-colors blue,green \"npm run dev --workspace @academiccloud/backend\" \"npm run dev --workspace @academiccloud/frontend\"",
    "dev:backend": "npm run dev --workspace @academiccloud/backend",
    "dev:frontend": "npm run dev --workspace @academiccloud/frontend",
    "db:migrate": "npm run db:migrate --workspace @academiccloud/backend",
    "db:migrate:prod": "npm run db:migrate:prod --workspace @academiccloud/backend --",
    "maintenance": "npm run maintenance --workspace @academiccloud/backend --",
    "maintenance:prod": "npm run maintenance:prod --workspace @academiccloud/backend --",
    "auth:benchmark": "npm run auth:benchmark --workspace @academiccloud/backend",
    "backup": "npm run backup --workspace @academiccloud/backend --",
    "backup:prod": "npm run backup:prod --workspace @academiccloud/backend --",
    "account:provision": "npm run account:provision --workspace @academiccloud/backend --",
    "account:provision:prod": "npm run account:provision:prod --workspace @academiccloud/backend --",
    "acceptance:compiled": "npm run acceptance:compiled --workspace @academiccloud/backend",
    "test:acceptance-tools": "node --test scripts/production-e2e-acceptance.test.mjs",
    "ops:audit": "node scripts/production-readiness-audit.mjs",
    "test:ops-audit": "node --test scripts/production-readiness-audit.test.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^10.0.4",
    "typescript": "^7.0.2"
  }
}
