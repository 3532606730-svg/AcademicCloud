HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
NODE_ENV=development
APP_ORIGIN=http://127.0.0.1:5173
DATABASE_PATH=../database/academiccloud.sqlite
MIGRATIONS_DIRECTORY=../database/migrations

# Object storage is configured only when the Alibaba OSS adapter is composed.
# Keep credentials server-side and supply real values through deployment secrets.
STORAGE_PROVIDER=memory
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
OSS_REGION=oss-cn-hangzhou
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# OSS_STS_TOKEN=
OSS_UPLOAD_AUTHORIZATION_SECONDS=300
OSS_DOWNLOAD_AUTHORIZATION_SECONDS=300
