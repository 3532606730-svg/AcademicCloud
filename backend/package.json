{
  "name": "@academiccloud/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "npm run build --workspace @academiccloud/compute-contracts && tsx watch --env-file-if-exists=.env src/main.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build --workspace @academiccloud/compute-contracts && tsx --test test/**/*.test.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "db:migrate": "tsx --env-file-if-exists=.env src/persistence/sqlite/migrate.ts",
    "db:migrate:prod": "node dist/persistence/sqlite/migrate.js",
    "maintenance": "tsx --env-file-if-exists=.env src/maintenance/main.ts",
    "maintenance:prod": "node dist/maintenance/main.js",
    "backup": "tsx --env-file-if-exists=.env src/operations/backup-main.ts",
    "backup:prod": "node dist/operations/backup-main.js",
    "ops:recovery": "tsx --env-file-if-exists=.env src/operations/recovery-main.ts",
    "ops:recovery:prod": "node dist/operations/recovery-main.js",
    "account:provision": "tsx --env-file-if-exists=.env src/operations/account-main.ts",
    "account:provision:prod": "node dist/operations/account-main.js",
    "acceptance:compiled": "node scripts/compiled-acceptance.mjs",
    "auth:benchmark": "tsx scripts/password-benchmark.ts"
  },
  "dependencies": {
    "@academiccloud/compute-contracts": "0.1.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/rate-limit": "^11.2.0",
    "ali-oss": "6.23.0",
    "argon2": "^0.45.1",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.11.3",
    "pinyin-pro": "3.27.0"
  },
  "devDependencies": {
    "@types/ali-oss": "6.23.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.23.12"
  }
}
