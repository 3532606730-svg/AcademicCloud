{
  "name": "@academiccloud/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test test/**/*.test.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "db:migrate": "tsx --env-file-if-exists=.env src/persistence/sqlite/migrate.ts",
    "auth:benchmark": "tsx scripts/password-benchmark.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/rate-limit": "^11.2.0",
    "ali-oss": "6.23.0",
    "argon2": "^0.45.1",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.11.3"
  },
  "devDependencies": {
    "@types/ali-oss": "6.23.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.23.12"
  }
}
